{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "VeriMundi": "Host=localhost;Port=5432;Database=verimundi;Username=verimundi;Password=verimundi"
  },
  "Ingestion": {
    "EnableRss": false,
    "EnableGdelt": false,
    "GdeltQuery": "sourcelang:english",
    "FixturePath": ""
  },
  "Ai": {
    "ApiKey": "",
    "BaseUrl": "https://api.openai.com/v1",
    "Model": "gpt-4o-mini",
    "MaxOutputTokens": 1200,
    "Temperature": 0.2,
    "TimeoutSeconds": 45,
    "AskPerMinutePerIp": 10
  },
  "RateLimiting": {
    "Provider": "",
    "WritePerMinute": 30,
    "AskPerMinute": 10,
    "ReportPerMinute": 10,
    "WindowSeconds": 60,
    "RetryAfterSeconds": 60,
    "RedisConnection": ""
  },
  "App": {
    "MaintenanceMode": false,
    "MinimumAppVersion": "1.0.0",
    "MaintenanceMessage": "VeriMundi is temporarily unavailable for maintenance. Please try again later."
  },
  "Ops": {
    "AdminIngestionToken": ""
  },
  "Telemetry": {
    "EnablePrometheus": false,
    "PrometheusPath": "/metrics"
  },
  "Urls": "http://0.0.0.0:5080"
}
